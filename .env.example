# ---- Backend (required) ----
# Get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Contact email sent in the User-Agent header, per Last.fm API terms of service
USER_AGENT_CONTACT=

# ---- Backend (optional) ----
# Only needed for POST /resolve-spotify-url. Leave blank to disable that endpoint.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local (non-Docker) Redis. Docker Compose overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ---- Frontend ----
# Base URL the browser uses to reach the API
VITE_API_BASE_URL=http://localhost:8000
